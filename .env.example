# -----------------------------------------------------------------------------
# Eventzo environment variables. Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local`. See README.md → "Credentials" for where to find each.
# -----------------------------------------------------------------------------

# Supabase project URL (Dashboard → Project Settings → Data API → Project URL)
# Local stack: http://127.0.0.1:54321  (printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Either the legacy "anon" key or the new "publishable" key
# (Dashboard → Project Settings → API Keys). Safe to expose to the browser;
# all access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY. Legacy "service_role" key or the new "secret" key. Bypasses RLS.
# Only used by src/lib/supabase/admin.ts (guarded by `import "server-only"`).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public base URL of this app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Razorpay (Phase 5). TEST MODE keys only until the CA review (D8) is done.
# Dashboard → Account & Settings → API Keys (switch to Test Mode first).
# Leave empty to run without online payments: the Pay buttons then show why
# they're disabled, and vendors can still record offline payments.
# -----------------------------------------------------------------------------
# Key id is not secret (Checkout uses it in the browser) but is read on the server.
RAZORPAY_KEY_ID=
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=
# SERVER-ONLY. Dashboard → Webhooks → Add webhook: URL <site>/api/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=

# Dummy payment gateway for demos/testing while Razorpay isn't connected.
# true = "Pay" opens a clearly labelled simulated checkout (no real money).
# Ignored when Razorpay keys are set. NEVER true for real customers.
PAYMENTS_SIMULATOR=false

# ---- Notifications (Phase 6) -------------------------------------------------
# No WhatsApp/email provider is connected yet; messages wait in the outbox
# (/admin/notifications). true = dev simulator marks them "sent" without
# contacting anyone. NEVER true for real customers.
NOTIFICATIONS_SIMULATOR=false
# Shared secret for the scheduled outbox run (GET /api/cron/notifications with
# "Authorization: Bearer <secret>"). Generate a long random string.
CRON_SECRET=
